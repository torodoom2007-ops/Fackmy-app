rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function chatMember() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    // IMPORTANT: The current frontend stores email and profile data together in users/{uid}.
    // Before production, move private fields (email, billing identifiers) to privateUsers/{uid}
    // and only expose display-safe fields in publicProfiles/{uid}.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if self(uid)
        && request.resource.data.role == 'regular'
        && request.resource.data.isPro == false
        && request.resource.data.subscriptionStatus == 'free';
      allow update: if self(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.isPro == resource.data.isPro
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName','username','city','birthDate','bio','profileImg','profileImg2','profileCompleted','isOnline','likesCount','updatedAt']);
      allow delete: if self(uid);
      match /likes/{likerUid} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == likerUid);
        allow create, update: if self(likerUid);
        allow delete: if self(likerUid);
      }
    }

    match /chats/{chatId} {
      allow read: if chatMember();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.initiatedBy == request.auth.uid;
      allow update: if chatMember()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.initiatedBy == resource.data.initiatedBy;
      allow delete: if false;
      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if signedIn() && request.auth.uid in parentChat().participants;
        allow create: if signedIn()
          && request.auth.uid in parentChat().participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update: if signedIn()
          && request.auth.uid in parentChat().participants
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text;
        allow delete: if false;
      }
    }
  }
}
